{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocyte.local/contracts/swa-cli.schema.json",
  "title": "SWA native execution command and response",
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "enum": ["status", "capabilities", "controller.open", "controller.show", "controller.close", "task.create", "task.show", "task.list", "task.complete", "task.result", "worker.start", "worker.show", "worker.list", "worker.read", "worker.send", "worker.stop", "worker.release", "request.show"] },
        "project_id": { "type": "string", "minLength": 1 },
        "controller": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "dispatch_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "format": "uuid" },
        "workdir": { "type": "string", "minLength": 1 },
        "spec_file": { "type": "string", "minLength": 1 },
        "input_file": { "type": "string", "minLength": 1 },
        "result_file": { "type": "string", "minLength": 1 },
        "output_dir": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "agent": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "source": { "const": "transcript" },
        "cursor": { "type": "string", "minLength": 1 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "description": "Each action accepts only its documented fields. Mutations require the original canonical UUID; task/result paths are checked against current project directory permission. Trusted caller, native identities and context cannot be supplied here."
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason", "source"],
      "properties": {
        "status": {"enum": ["available", "unavailable", "unknown"]},
        "reason": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string"}
      }
    },
    "settingsSource": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {"kind": {"enum": ["native", "orca-profile"]}, "path": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 0}}
    },
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["settings_revision", "allow_directory", "allowed_subdirs", "allowed_actions", "allowed_tools", "grant_actions", "external_model_cli", "allow_agent_control"],
      "properties": {
        "settings_revision": {"type": "integer", "minimum": 1},
        "allow_directory": {"type": "boolean"},
        "allowed_subdirs": {"type": ["array", "null"], "items": {"type": "string"}},
        "allowed_actions": {"type": ["array", "null"], "items": {"type": "string"}},
        "allowed_tools": {"type": ["array", "null"], "items": {"type": "string"}},
        "grant_actions": {"type": ["array", "null"], "items": {"type": "string"}},
        "external_model_cli": {"type": "string"}, "allow_agent_control": {"type": "boolean"}
      }
    },
    "agentSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "adapter", "execution_mode", "executable", "version", "model", "provider", "external_target", "settings_source", "settings_revision", "configuration_version"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1}, "adapter": {"type": "string", "minLength": 1}, "execution_mode": {"const": "structured"},
        "executable": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "external_target": {"type": "string", "minLength": 1},
        "settings_source": {"$ref": "#/$defs/settingsSource"}, "settings_revision": {"type": "integer", "minimum": 0}, "configuration_version": {"type": "string", "minLength": 1}
      }
    },
    "installedObservation": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason", "source"],
      "properties": {"status": {"enum": ["available", "unavailable", "unknown"]}, "reason": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "checked_at": {"type": "string"}, "executable": {"type": "string"}, "version": {"type": "string"}},
      "if": {"properties": {"status": {"const": "available"}}}, "then": {"required": ["executable", "version"]}
    },
    "configuredObservation": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason", "source"],
      "properties": {"status": {"enum": ["available", "unavailable", "unknown"]}, "reason": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "checked_at": {"type": "string"}, "model": {"type": "string"}, "provider": {"type": "string"}, "account_source": {"type": "string"}},
      "if": {"properties": {"status": {"const": "available"}}}, "then": {"required": ["model", "provider", "account_source"]}
    },
    "capabilities": {
      "type": "object", "additionalProperties": false, "required": ["schema", "source_revision", "registry", "discovery", "agents"],
      "properties": {
        "schema": {"const": "swa.capabilities.v1"}, "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "registry": {"type": "object", "additionalProperties": false, "required": ["orca_version", "artifact_sha256"], "properties": {"orca_version": {"const": "1.4.230"}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
        "discovery": {"type": "object", "additionalProperties": false, "required": ["host", "platform", "observed_at", "settings_source"], "properties": {"host": {"const": "local"}, "platform": {"type": "string"}, "observed_at": {"type": "string"}, "settings_source": {"$ref": "#/$defs/settingsSource"}}},
        "agents": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "adapter", "execution_mode", "registered", "enabled", "installed", "configured", "launchable", "control", "requirements"], "properties": {
          "id": {"type": "string", "minLength": 1}, "adapter": {"type": "string", "minLength": 1}, "execution_mode": {"const": "structured"},
          "registered": {"$ref": "#/$defs/observation"}, "enabled": {"$ref": "#/$defs/observation"}, "installed": {"$ref": "#/$defs/installedObservation"}, "configured": {"$ref": "#/$defs/configuredObservation"}, "launchable": {"$ref": "#/$defs/observation"},
          "control": {"type": "object", "additionalProperties": false, "required": ["start", "send", "read", "stop", "resume", "tools"], "properties": {"start": {"$ref": "#/$defs/observation"}, "send": {"$ref": "#/$defs/observation"}, "read": {"$ref": "#/$defs/observation"}, "stop": {"$ref": "#/$defs/observation"}, "resume": {"$ref": "#/$defs/observation"}, "tools": {"$ref": "#/$defs/observation"}}},
          "requirements": {"$ref": "#/$defs/requirements"}
        }}}
      }
    },
    "nativeError": {
      "type": "object",
      "required": ["code", "message", "retryable", "required_action"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "retryable": { "const": false },
        "required_action": { "type": "string", "minLength": 1 },
        "data": {}
      },
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "request_id": { "type": "string" },
        "runtime_id": { "type": "string" },
        "authority_domain": { "type": "string" },
        "controller": { "type": "string" },
        "run_id": { "type": "string" },
        "task_id": { "type": "string" },
        "dispatch_id": { "type": "string" },
        "result": {},
        "error": { "$ref": "#/$defs/nativeError" }
      },
      "additionalProperties": false,
      "description": "Result preserves actual native records and provenance. HTTP transport success is insufficient for mutation success; unknown outcomes retain the original request and resource ownership."
    }
  },
  "$ref": "#/$defs/command"
}
